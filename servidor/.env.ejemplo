# Copiá este archivo como .env y completá los valores reales.
# Sin .env el servidor arranca en modo producción (DEBUG apagado) y exige SECRET_KEY.

# Generá una clave con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta

# True solo en tu PC para desarrollar. En el servidor del colegio: False
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=colegio
DB_USER=postgres
DB_PASSWORD=tu-contraseña-de-postgres
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
